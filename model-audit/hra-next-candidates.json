  "openGaps": [
    {
      "system": "organs",
      "reviewState": "BLOCKED_SOURCE_MAPPING",
      "reason": "Urinary detail needs four separately pinned kidney reference objects (left/right x male/female) next; other GI organs, upper airway, lymphatic, endocrine, reproductive and other organ-system structures remain open. Source releases are independent and may overlap."
    },
    {
      "system": "organs",
      "reviewState": "BLOCKED_ANATOMICAL_REVIEW",
      "reason": "Heart and liver overlap vasculature; lung excludes separate larynx, trachea and main bronchi; small intestine may contain unmapped measurement guides. Do not confuse root/group nodes, markers or overlapping reference objects with standalone anatomy."
    },
    {
      "system": "nerves",
      "reviewState": "BLOCKED_SOURCE_MAPPING",
      "reason": "Spinal cord is central nervous system, not peripheral nerve coverage. Female crosswalk has a missing fifth sacral segment relative to male; record a gap, review source-specific variant, do not infer missing geometry."
    },
    {
      "system": "all",
      "reviewState": "NOT_DOWNLOADED",
      "reason": "No binary model bytes obtained, no checked local geometry, render, measured bounds, cross-organ registration or clinical review. All sources await identical quality gate."
    }
